# /// script
# dependencies = [
#     "transformers>=5.14.0",
#     "torch",
#     "torchaudio",
#     "numpy",
#     "soundfile",
#     "librosa",
#     # librosa's transitive numba: on Python 3.14, unpinned resolution backslides to source-only
#     # numba 0.53.1 / llvmlite 0.36.0 (fails to build); this floor forces the cp314 wheels
#     # (numba 0.66.0 / llvmlite 0.48.0). Inert on 3.12/3.13 (same versions). llvmlite is pulled
#     # transitively by numba, so no separate pin is needed.
#     "numba>=0.66",
#     "accelerate",
#     "sentencepiece",
#     "protobuf",
