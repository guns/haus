if TYPE_CHECKING:
    from collections.abc import Callable, Iterable, Iterator, Sequence


logger = logging.getLogger(__name__)


# ---------------------------------------------------------------------------
# Custom lint rules: pylint checkers
# ---------------------------------------------------------------------------


def is_uppercase_name(name: str) -> bool:
    if not name:
        return False
    return name.lstrip("_")[:1].isupper()


class UppercaseImportChecker(BaseChecker):
    """Lowercase symbols must not be imported directly; import the module instead."""

    name = "uppercase-import-checker"
    # pylint checker API requires mutable class-level dict
    msgs = {  # noqa: RUF012
        "C2000": (
            'Lowercase symbol "%s" should not be imported directly. Import the module instead and use module.%s()',
            "lowercase-import-not-allowed",
            "Only uppercase symbols (classes, constants) and modules may be imported directly.",
        )
    }
    allowed_symbols = frozenset(["annotations", "datetime", "timezone"])

    def visit_importfrom(self, node: nodes.ImportFrom) -> None:
        try:
            imported = node.do_import_module()
        except astroid.AstroidImportError:
            return
        for name, _ in node.names:
            if name == "*" or is_uppercase_name(name):
                continue
            if name in self.allowed_symbols:
                continue
            # Allow module/submodule imports
            try:
                imported.import_module(name, relative_only=True)
                continue
            except astroid.AstroidImportError:
                pass
            self.add_message("lowercase-import-not-allowed", node=node, args=(name, name))


class PartitionChecker(BaseChecker):
    """Flag split/rsplit with maxsplit=1 and explicit separator; suggest partition/rpartition."""

    name = "partition-checker"
    # pylint checker API requires mutable class-level dict
    msgs = {  # noqa: RUF012
        "C2001": (
            "Use %s() instead of %s(..., maxsplit=1)",
            "use-partition",
            "partition/rpartition is more reliable than split/rsplit with maxsplit=1.",
        )
    }

    def visit_call(self, node: nodes.Call) -> None:
        if not isinstance(node.func, nodes.Attribute):
            return
        method = node.func.attrname
        if method not in ("split", "rsplit"):
            return
        # Check for explicit separator (first positional arg or 'sep' keyword)
        # None means whitespace splitting, same as no separator
        sep_arg = node.args[0] if node.args else None
        sep_kw = next((kw.value for kw in node.keywords if kw.arg == "sep"), None)
        if sep_arg is None and sep_kw is None:
            return
        if isinstance(sep_arg, nodes.Const) and sep_arg.value is None:
            return
        if isinstance(sep_kw, nodes.Const) and sep_kw.value is None:
            return
        # Check maxsplit=1: positional (index 1) or keyword
        maxsplit_val = None
        if len(node.args) >= 2:
            arg = node.args[1]
            if isinstance(arg, nodes.Const) and arg.value == 1:
                maxsplit_val = 1
        for kw in node.keywords:
            if kw.arg == "maxsplit" and isinstance(kw.value, nodes.Const) and kw.value.value == 1:
                maxsplit_val = 1
        if maxsplit_val != 1:
            return
        replacement = "partition" if method == "split" else "rpartition"
        self.add_message("use-partition", node=node, args=(replacement, method))


def register(linter: PyLinter) -> None:
    linter.register_checker(UppercaseImportChecker(linter))
    linter.register_checker(PartitionChecker(linter))


# ---------------------------------------------------------------------------
# Custom lint rules: AST-based triple-quoted string checker
# ---------------------------------------------------------------------------

MSG_QUOTES_NOT_ALONE = "opening triple quotes must be alone on their line"
MSG_CONTENT_ON_OPENING = "content must not start on same line as opening triple quotes"
MSG_INDENT = "content must maintain indentation of opening triple quotes"
MSG_HINT = "; use inspect.cleandoc() for indented multiline strings"


def check_tripleq_strings(paths: Iterable[Path]) -> bool:
    ok = True
    for path in paths:
        for lineno, msg in _check_tripleq_file(path):
            print(f"{path}:{lineno}: {msg}")
            ok = False
    return ok


def _check_tripleq_file(path: Path) -> list[tuple[int, str]]:
    errors: list[tuple[int, str]] = []
    try:
        source = path.read_text()
        tree = ast.parse(source, filename=str(path))
    except (SyntaxError, OSError):
        return errors

    lines = source.splitlines()

    for node in ast.walk(tree):
        if not isinstance(node, (ast.JoinedStr, ast.Constant)):
            continue
        if isinstance(node, ast.Constant) and not isinstance(node.value, (str, bytes)):
            continue
        if node.lineno == node.end_lineno or node.end_lineno is None:
            continue

        line = lines[node.lineno - 1] if node.lineno <= len(lines) else ""
        col = node.col_offset
        snippet = line[col:]

        # Only check actual triple-quoted strings, not implicit concatenation
        # Strip string prefixes (f, r, b, u and combinations)
        stripped = snippet.lstrip("fFrRbBuU")
        if not stripped.startswith(('"""', "'''")):
            continue

        before = line[:col]
        after_quotes = stripped[3:]
        is_simple = _is_simple_assign(tree, node)
        line_indent = _indent_level(line)
        is_backslash_continuation = after_quotes.strip() == "\\" and before.strip().endswith("=")

        # Allow backslash continuation for simple assignment at module level (indent 0)
        if is_simple and line_indent == 0 and is_backslash_continuation:
            continue

        # Check opening quotes alone on line (except simple assignment)
        if not is_simple and before.strip():
            errors.append((node.lineno, MSG_QUOTES_NOT_ALONE + MSG_HINT))

        # Check content after opening quotes (backslash only allowed at indent 0)
        if after_quotes.strip() and (after_quotes.strip() != "\\" or line_indent > 0):
            errors.append((node.lineno, MSG_CONTENT_ON_OPENING + MSG_HINT))

        # Check indentation of content lines (relative to line indent, not quote column)
        for i in range(node.lineno, node.end_lineno):
            content_line = lines[i] if i < len(lines) else ""
            if content_line.strip() and _indent_level(content_line) < line_indent:
                errors.append((i + 1, MSG_INDENT + MSG_HINT))

    return errors


def _indent_level(line: str) -> int:
    return len(line) - len(line.lstrip())


def _is_simple_assign(tree: ast.AST, string_node: ast.Constant | ast.JoinedStr) -> bool:
    return any(isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is string_node for node in ast.walk(tree))


# ---------------------------------------------------------------------------
# Pylint runner helpers
# ---------------------------------------------------------------------------


def _run_pylint_check(paths: Iterable[Path], message: str, output: TextIO | None = None) -> bool:
    linter = PyLinter()
    linter.load_plugin_modules([__name__])
    linter.disable("all")
    linter.enable(message)
    linter.set_reporter(TextReporter(output))
    linter.check([str(p) for p in paths])
    return not linter.stats.by_msg


def check_imports(paths: Iterable[Path]) -> bool:
    return _run_pylint_check(paths, "lowercase-import-not-allowed")


def check_partition(paths: Iterable[Path]) -> bool:
    return _run_pylint_check(paths, "use-partition")


# ---------------------------------------------------------------------------
# Embedded self-tests
# ---------------------------------------------------------------------------

TRIPLEQ_TESTS: dict[str, tuple[str, list[int]]] = {
    "single-line triple-quoted string": ('x = """single line"""', []),
    "simple assignment, content at line indent": ('x = """\ncontent\n"""', []),
    "backslash continuation at level 0": ('MSG = """\\\ncontent\n"""', []),
    "f-string backslash continuation at level 0": ('MSG = f"""\\\nHello {name}\n"""', []),
    "docstring": ('def f():\n    """\n    Docstring.\n    """\n    pass', []),
    "nested assignment": ('def f():\n    x = """\n    content\n    """', []),
    "in list with proper indent": ('items = [\n    """\n    content\n    """\n]', []),
    "implicit string concatenation (not triple-quoted)": ('x = (\n    f"first "\n    f"second"\n)', []),
    "content on opening line": ('x = """content\nmore\n"""', [1]),
    "quotes not alone (in function call)": ('func("""\nbad\n""")', [1]),
    "content not indented enough": ('def f():\n    x = """\nnot indented\n"""', [3, 4]),
    "backslash continuation indented (not allowed)": ('def f():\n    x = """\\\n    content\n    """', [2]),
    "f-string backslash continuation indented (not allowed)": (
        'def f():\n    x = f"""\\\n    Hello {name}\n    """',
        [2],
    ),
    "f-string with content on opening line": ('x = f"""content\nmore\n"""', [1]),
    "f-string quotes not alone (in function call)": ('func(f"""\nbad\n""")', [1]),
    "r-string with content on opening line": ('x = r"""content\nmore\n"""', [1]),
    "b-string with content on opening line": ('x = b"""content\nmore\n"""', [1]),
    "fr-string with content on opening line": ('x = fr"""content\nmore\n"""', [1]),
    "rf-string with content on opening line": ('x = rf"""content\nmore\n"""', [1]),
    "br-string with content on opening line": ('x = br"""content\nmore\n"""', [1]),
}

IMPORT_TESTS: dict[str, tuple[str, bool]] = {
    "uppercase symbol (class)": ("from pathlib import Path", True),
    "uppercase symbol (exception class)": ("from collections import OrderedDict", True),
    "module import": ("import os", True),
    "submodule import": ("from os import path", True),
    "allowed exception - annotations": ("from __future__ import annotations", True),
    "allowed exception - datetime": ("from datetime import datetime", True),
    "allowed exception - timezone": ("from datetime import timezone", True),
    "lowercase class (no introspection, lowercase = invalid)": ("from functools import partial", False),
    "lowercase class": ("from itertools import chain", False),
    "lowercase function (join)": ("from os.path import join", False),
    "lowercase function (exists)": ("from os.path import exists", False),
    "lowercase constant": ("from string import ascii_letters", False),
}

PARTITION_TESTS: dict[str, tuple[str, bool]] = {
    "split with maxsplit=1 positional": ('x.split(":", 1)', False),
    "split with maxsplit=1 keyword": ('x.split(":", maxsplit=1)', False),
    "split with sep keyword and maxsplit=1": ('x.split(sep=":", maxsplit=1)', False),
    "rsplit with maxsplit=1 positional": ('x.rsplit(":", 1)', False),
    "rsplit with maxsplit=1 keyword": ('x.rsplit(":", maxsplit=1)', False),
    "split without maxsplit": ('x.split(":")', True),
    "split with maxsplit=2": ('x.split(":", 2)', True),
    "split with no separator (whitespace)": ("x.split(maxsplit=1)", True),
    "rsplit with no separator (whitespace)": ("x.rsplit(maxsplit=1)", True),
    "split with None separator positional": ("x.split(None, 1)", True),
    "rsplit with None separator positional": ("x.rsplit(None, 1)", True),
    "split with None separator keyword": ("x.split(sep=None, maxsplit=1)", True),
    "rsplit with None separator keyword": ("x.rsplit(sep=None, maxsplit=1)", True),
    "partition (already correct)": ('x.partition(":")', True),
    "rpartition (already correct)": ('x.rpartition(":")', True),
}


def _run_pylint_tests(tests: dict[str, tuple[str, bool]], message: str, label: str) -> int:
    failed = 0
    for name, (source, should_pass) in tests.items():
        with tempfile.NamedTemporaryFile(mode="w", suffix=".py", delete=False) as f:
            f.write(source + "\n")
            f.flush()
            path = Path(f.name)

        try:
            passed = _run_pylint_check([path], message, io.StringIO())
        finally:
            path.unlink()

        if passed != should_pass:
            status = "pass" if should_pass else "fail"
            print(f"FAIL {label} [{name}]: expected {status}, got {'pass' if passed else 'fail'}")
            print(f"  source: {source!r}")
            failed += 1
    return failed


def run_tests() -> int:
    failed = 0

    # Triple-quoted string tests
    for name, (source, expected_lines) in TRIPLEQ_TESTS.items():
        with tempfile.NamedTemporaryFile(mode="w", suffix=".py", delete=False) as f:
            f.write(source.strip() + "\n")
            f.flush()
            path = Path(f.name)

        try:
            errors = _check_tripleq_file(path)
            actual_lines = sorted({e[0] for e in errors})
        finally:
            path.unlink()

        if actual_lines != sorted(expected_lines):
            print(f"FAIL tripleq [{name}]: expected {expected_lines}, got {actual_lines}")
            print(f"  source: {source.strip()!r}")
            failed += 1

    # Import tests
    failed += _run_pylint_tests(IMPORT_TESTS, "lowercase-import-not-allowed", "import")

    # Partition tests
    failed += _run_pylint_tests(PARTITION_TESTS, "use-partition", "partition")

    total = len(TRIPLEQ_TESTS) + len(IMPORT_TESTS) + len(PARTITION_TESTS)
    if failed:
        print(f"{failed}/{total} test(s) failed")
        return 1
    print(f"{total} tests passed")
    return 0


# ---------------------------------------------------------------------------
# File discovery
# ---------------------------------------------------------------------------


def is_python_script(path: Path) -> bool:
    """Check if a non-.py file is a Python script by inspecting its first line."""
    try:
        with path.open("rb") as f:
            first_line = f.readline(256)
    except OSError:
        return False
    return b"python" in first_line or b"uv run" in first_line


def is_python_file(path: Path) -> bool:
    return (path.suffix == ".py" and path.is_file()) or (path.is_file() and is_python_script(path))


def discover_files(paths: Sequence[Path]) -> tuple[list[Path], bool]:
    """
    Resolve positional arguments to a list of Python files.

    Returns (files, ok) where ok is False if any path did not exist.
    """
    result: list[Path] = []
    ok = True
    for p in paths:
        resolved = p.resolve()
        if not resolved.exists():
            print(f"Path does not exist: {p}")
            ok = False
            continue
        if resolved.is_file():
            result.append(resolved)
        elif resolved.is_dir():
            result.extend(_files_in_directory(resolved))
    # Deduplicate while preserving order
    return list(dict.fromkeys(result)), ok


def _files_in_directory(directory: Path) -> list[Path]:
    """Enumerate Python files in a directory, using git ls-files if available."""
    git_result = subprocess.run(["git", "ls-files", "-z"], capture_output=True, text=True, check=False, cwd=directory)
    if git_result.returncode == 0:
        files = []
        for entry in git_result.stdout.split("\0"):
            if not entry:
                continue
            path = directory / entry
            if is_python_file(path):
                files.append(path)
        return files
    # Not a git repo — recursive walk
    return [p for p in directory.rglob("*") if is_python_file(p)]


# ---------------------------------------------------------------------------
# Orchestration helpers
# ---------------------------------------------------------------------------


def file_hash(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def file_desc(paths: Sequence[Path]) -> str:
    if len(paths) == 1:
        return str(paths[0])
    return f"{len(paths)} files"


def run_cmd(
    name: str,
    cmd: Sequence[str],
    *,
    env: dict[str, str] | None = None,
    pass_fds: tuple[int, ...] = (),
    cwd: Path | None = None,
) -> bool:
    logger.warning("> %s", name)
    if subprocess.run(cmd, env=env, pass_fds=pass_fds, cwd=cwd, check=False).returncode != 0:
        print(f"Command failed: {name}")
        return False
    return True


def has_inline_script_metadata(path: Path) -> bool:
    """Check if a file contains PEP 723 inline script metadata."""
    try:
        return re.search(r"^\s*# /// script\s*$", path.read_text(), re.MULTILINE) is not None
    except OSError:
        return False


