_libc = ctypes.CDLL(None, use_errno=True)
_libc.memfd_create.argtypes = [ctypes.c_char_p, ctypes.c_uint]
_libc.memfd_create.restype = ctypes.c_int


def _memfd_create(name: bytes, data: bytes) -> int:
    """Create a memfd containing data, seeked to the beginning. Returns the fd."""
    fd: int = _libc.memfd_create(name, 0)
    if fd < 0:
        errno = ctypes.get_errno()
        raise OSError(errno, os.strerror(errno))
    try:
        os.write(fd, data)
        os.lseek(fd, 0, 0)
    except BaseException:
        os.close(fd)
        raise
    return fd


def _walk_up_find(start: Path, predicate: Callable[[Path], bool]) -> Path | None:
    """Walk up from start to filesystem root, returning the first directory matching predicate."""
    current = start if start.is_dir() else start.parent
    while True:
        if predicate(current):
            return current
        parent = current.parent
        if parent == current:
            return None
        current = parent


def _has_ruff_config(start: Path) -> bool:
    """Walk up from start looking for ruff configuration files."""

    def _check(directory: Path) -> bool:
        if (directory / "ruff.toml").is_file() or (directory / ".ruff.toml").is_file():
            return True
        pyproject = directory / "pyproject.toml"
        if pyproject.is_file():
            try:
                data = tomllib.loads(pyproject.read_text())
                if "ruff" in data.get("tool", {}):
                    return True
            except (OSError, ValueError, tomllib.TOMLDecodeError):
                pass
        return False

    return _walk_up_find(start, _check) is not None


def _has_mypy_config(start: Path) -> bool:
    """Walk up from start looking for mypy configuration files."""

    def _check(directory: Path) -> bool:
        for name in ("mypy.ini", ".mypy.ini"):
            if (directory / name).is_file():
                return True
        setup_cfg = directory / "setup.cfg"
        if setup_cfg.is_file():
            try:
                cfg = configparser.ConfigParser()
                cfg.read(setup_cfg)
                if cfg.has_section("mypy"):
                    return True
            except (configparser.Error, ValueError):
                pass
        pyproject = directory / "pyproject.toml"
        if pyproject.is_file():
            try:
                data = tomllib.loads(pyproject.read_text())
                if "mypy" in data.get("tool", {}):
                    return True
            except (OSError, ValueError, tomllib.TOMLDecodeError):
                pass
        return False

    return _walk_up_find(start, _check) is not None


def _find_uv_project_root(start: Path) -> Path | None:
    """Walk up from start looking for a uv-managed project (pyproject.toml with sibling uv.lock)."""

    def _check(directory: Path) -> bool:
        return (directory / "pyproject.toml").is_file() and (directory / "uv.lock").is_file()

    return _walk_up_find(start, _check)


@functools.cache
def _parsed_default_config() -> dict[str, dict[str, object]]:
    """Parse _DEFAULT_CONFIG once and cache the result."""
    data: dict[str, dict[str, object]] = tomllib.loads(_DEFAULT_CONFIG)["tool"]
    return data


def _default_ruff_config() -> bytes:
    """Extract [tool.ruff] from the embedded config and serialize as standalone TOML."""
    return tomli_w.dumps(_parsed_default_config()["ruff"]).encode()


def _default_mypy_config() -> bytes:
    """
    Extract [tool.mypy] from the embedded config and serialize as INI.

    mypy determines config format by file extension.  /proc/self/fd/N has no
    extension, so mypy falls back to INI parsing.  INI booleans use True/False.
    """
    lines = ["[mypy]"]
    for key, value in _parsed_default_config()["mypy"].items():
        lines.append(f"{key} = {value}")
    lines.append("")
    return "\n".join(lines).encode()


@contextlib.contextmanager
def _ruff_config_args(paths: Sequence[Path]) -> Iterator[tuple[list[str], tuple[int, ...]]]:
    """Yield (extra_args, pass_fds) for ruff, providing default config via memfd if needed."""
    if _has_ruff_config(paths[0]):
        yield [], ()
        return
    fd = _memfd_create(b"ruff.toml", _default_ruff_config())
    try:
        yield ["--config", f"/proc/self/fd/{fd}"], (fd,)
    finally:
        os.close(fd)


@contextlib.contextmanager
def _mypy_config_args(paths: Sequence[Path]) -> Iterator[tuple[list[str], tuple[int, ...]]]:
    """Yield (extra_args, pass_fds) for mypy, providing default config via memfd if needed."""
    if _has_mypy_config(paths[0]):
        yield [], ()
        return
    fd = _memfd_create(b"mypy.ini", _default_mypy_config())
    try:
        yield ["--config-file", f"/proc/self/fd/{fd}"], (fd,)
    finally:
        os.close(fd)


# ---------------------------------------------------------------------------
# Pipeline stages
# ---------------------------------------------------------------------------


def ensure_trailing_newline(path: Path, *, check: bool) -> bool:
    """Ensure file ends with a trailing newline. Returns True if ok."""
    with path.open("rb") as f:
        f.seek(0, 2)
        if f.tell() == 0:
            return True
        f.seek(-1, 2)
        if f.read(1) == b"\n":
            return True
    if check:
        print(f"File does not end with a trailing newline: {path}")
        return False
    with path.open("ab") as out:
        out.write(b"\n")
    return True


def run_autoimport(paths: Sequence[Path], *, check: bool) -> bool:
    """Run autoimport via the Python API. Returns True if ok."""
    desc = file_desc(paths)
    logger.warning("> autoimport %s", desc)
    ok = True
    for path in paths:
        try:
            original = path.read_text()
        except OSError as e:
            print(f"Cannot read {path}: {e}")
            ok = False
            continue
        fixed = autoimport.fix_code(original)
        if fixed != original:
            if check:
                print(f"autoimport would modify: {path}")
                ok = False
            else:
                path.write_text(fixed)
    return ok


def run_ruff_check(paths: Sequence[Path], *, check: bool) -> bool:
    desc = file_desc(paths)
    path_strs = [str(p) for p in paths]
    cmd = ["ruff", "check", "--quiet", "--output-format=pylint"]
    if not check:
        cmd.append("--fix")

    with _ruff_config_args(paths) as (extra_args, pass_fds):
        cmd.extend(extra_args)
        cmd.extend(["--", *path_strs])
        return run_cmd(f"ruff check {desc}", cmd, pass_fds=pass_fds)


def run_ruff_format(paths: Sequence[Path], *, check: bool) -> bool:
    desc = file_desc(paths)
    path_strs = [str(p) for p in paths]
    cmd = ["ruff", "format", "--quiet"]
    if check:
        cmd.append("--check")

    with _ruff_config_args(paths) as (extra_args, pass_fds):
        cmd.extend(extra_args)
        cmd.extend(["--", *path_strs])
        return run_cmd(f"ruff format {desc}", cmd, pass_fds=pass_fds)


def run_mypy(paths: Sequence[Path]) -> bool:
    """Run mypy, partitioning PEP 723 scripts for individual invocation and grouping plain files by uv project."""
    # Strip VIRTUAL_ENV to avoid venv mismatch warnings
    mypy_env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}

    scripts: list[Path] = []
    plain: list[Path] = []
    for p in paths:
        if has_inline_script_metadata(p):
            scripts.append(p)
        else:
            plain.append(p)

    results: list[bool] = []

    # PEP 723 scripts: run mypy individually via uv export --script
    for path in scripts:
        with _mypy_config_args([path]) as (config_args, config_fds):
            results.append(_run_mypy_for_script(path, mypy_env, config_args, config_fds))

    # Group plain files by uv project root
    # Called per-file; benchmarked at ~30 µs/call (48 files in 1.4 ms) — negligible vs mypy runtime.
    project_groups: dict[Path | None, list[Path]] = {}
    for p in plain:
        root = _find_uv_project_root(p)
        project_groups.setdefault(root, []).append(p)

    # uv project groups: run mypy via uv run with cwd set to project root
    for root, group in project_groups.items():
        if root is not None:
            path_strs = [str(p) for p in group]
            desc = file_desc(group)
            results.append(
                run_cmd(
                    f"mypy {desc}",
                    [
                        "uv",
                        "run",
                        "--all-extras",
                        "mypy",
                        "--scripts-are-modules",
                        "--no-error-summary",
                        "--",
                        *path_strs,
                    ],
                    env=mypy_env,
                    cwd=root,
                )
            )

    # No-project group: bare mypy with embedded default config fallback
    no_project = project_groups.get(None, [])
    if no_project:
        with _mypy_config_args(no_project) as (config_args, config_fds):
            path_strs = [str(p) for p in no_project]
            desc = file_desc(no_project)
            results.append(
                run_cmd(
                    f"mypy {desc}",
                    ["mypy", "--scripts-are-modules", "--no-error-summary", *config_args, "--", *path_strs],
                    env=mypy_env,
                    pass_fds=config_fds,
                )
            )

    return all(results)


def _run_mypy_for_script(
    path: Path, env: dict[str, str], config_args: Sequence[str], config_fds: tuple[int, ...]
) -> bool:
    """Run mypy on a PEP 723 script using its inline dependencies."""
    export_result = subprocess.run(
        [
            "uv",
            "export",
            "--script",
            str(path),
            "--format",
            "requirements.txt",
            "--no-hashes",
            "--no-header",
            "--no-annotate",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if export_result.returncode != 0:
        print(f"uv export --script failed for {path}: {export_result.stderr}")
        return False
    r, w = os.pipe()
    try:
        os.write(w, export_result.stdout.encode())
        os.close(w)
        w = -1
        return run_cmd(
            f"mypy {path}",
            [
                "uv",
                "run",
                "--no-project",
                "--with",
                "mypy",
                "--with-requirements",
                f"/dev/fd/{r}",
                "--",
                "mypy",
                "--scripts-are-modules",
                "--no-error-summary",
                *config_args,
                "--",
                str(path),
            ],
            env=env,
            pass_fds=(r, *config_fds),
        )
    finally:
        if w >= 0:
            os.close(w)
        os.close(r)


def run_custom_lint(paths: Sequence[Path]) -> bool:
    """Run all custom lint rules."""
    logger.warning("> Running custom checks on %s", file_desc(paths))
    results = [check_imports(paths), check_partition(paths), check_tripleq_strings(paths)]
    return all(results)


# ---------------------------------------------------------------------------
# Main pipeline
# ---------------------------------------------------------------------------


def lint(paths: Sequence[Path], *, check: bool) -> bool:
    """Run the full linting pipeline. Returns True if everything is clean."""
    if not paths:
        return True

    # Ensure trailing newlines
    newline_ok = True
    for path in paths:
        if not ensure_trailing_newline(path, check=check):
            newline_ok = False

    # Hash files before linting
    hashes_before = {p: file_hash(p) for p in paths}

    # Run tools
    results = [
        newline_ok,
        run_autoimport(paths, check=check),
        run_ruff_check(paths, check=check),
        run_ruff_format(paths, check=check),
        run_mypy(paths),
        run_custom_lint(paths),
    ]

    success = all(results)

    # In fix mode, check if any files were modified
    if not check:
        for path in paths:
            if file_hash(path) != hashes_before[path]:
                print(f"File was modified by linting (run formatters before committing): {path}")
                success = False

    return success


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def parser() -> ArgumentParser:
    p = ArgumentParser(
        description=__doc__, formatter_class=lambda prog: RawTextHelpFormatter(prog, max_help_position=15)
    )
    p.add_argument("paths", metavar="path", nargs="*", type=Path, help="files or directories to lint")
    p.add_argument("-c", "--check", action="store_true", help="check mode: report issues without modifying files")
    p.add_argument("-v", "--verbose", action="store_true", help="show progress messages even when stderr is not a TTY")
    p.add_argument("--test", action="store_true", help="run embedded self-tests for custom lint rules")
    return p


def main() -> int:
    opts = parser().parse_args(sys.argv[1:])

    if opts.test:
        return run_tests()

    log_level = logging.WARNING if opts.verbose or sys.stderr.isatty() else logging.ERROR
    handler = logging.StreamHandler()
    handler.setFormatter(logging.Formatter("%(message)s"))
    logger.addHandler(handler)
    logger.setLevel(log_level)
    logger.propagate = False

    if not opts.paths:
        print("error: at least one path is required (or use --test)")
        return 1

    files, paths_ok = discover_files(opts.paths)
    if not files:
        print("No Python files found.")
        return 0 if paths_ok else 1

    ok = lint(files, check=opts.check)
    return 0 if (ok and paths_ok) else 1


if __name__ == "__main__":
    sys.exit(main())
